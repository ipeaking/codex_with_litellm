# Copy this file to .env before running LiteLLM locally.

# Provider key used by LiteLLM to call OpenAI models.
OPENAI_API_KEY=

# Optional provider key used by LiteLLM to call DeepSeek models.
DEEPSEEK_API_KEY=

# Key used by local apps/scripts when calling LiteLLM Proxy.
LITELLM_MASTER_KEY=sk-local-dev
LITELLM_BASE_URL=http://localhost:4000

# Local infrastructure defaults.
POSTGRES_USER=ai_course
POSTGRES_PASSWORD=ai_course
POSTGRES_DB=ai_course

# Course model aliases are configured in infra/litellm/config.yaml.
# You can change the underlying models later without touching app code.
